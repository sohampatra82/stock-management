<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h5 class="mb-0">Current Stock Report</h5>
  <div>
    <a href="/reports/stock?<%= filters.status ? 'status=' + filters.status + '&' : '' %>export=csv" class="btn btn-sm btn-outline-success">
      <i class="bi bi-download me-1"></i> Export CSV
    </a>
    <a href="/reports" class="btn btn-sm btn-outline-secondary">Back</a>
  </div>
</div>

<div class="panel mb-3">
  <div class="panel-body">
    <form method="GET" action="/reports/stock" class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small">Status Filter</label>
        <select name="status" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="available" <%= filters.status === 'available' ? 'selected' : '' %>>Available</option>
          <option value="low" <%= filters.status === 'low' ? 'selected' : '' %>>Low Stock</option>
          <option value="out" <%= filters.status === 'out' ? 'selected' : '' %>>Out of Stock</option>
        </select>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-sm btn-primary">Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Category</th>
            <th>Qty</th>
            <th>Min</th>
            <th>Unit</th>
            <th>Status</th>
            <th class="d-none d-md-table-cell">Location</th>
          </tr>
        </thead>
        <tbody>
          <% if (materials.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No materials found.</td></tr>
          <% } else { %>
            <% materials.forEach(function(m) { %>
              <% 
                let badgeClass = 'bg-success';
                let statusText = 'Available';
                if (m.quantity <= 0) { badgeClass = 'bg-danger'; statusText = 'Out of Stock'; }
                else if (m.quantity <= m.minimumStock) { badgeClass = 'bg-warning text-dark'; statusText = 'Low Stock'; }
              %>
              <tr>
                <td><code><%= m.code %></code></td>
                <td><%= m.name %></td>
                <td><%= m.category %></td>
                <td><strong><%= m.quantity %></strong></td>
                <td><%= m.minimumStock %></td>
                <td><%= m.unit %></td>
                <td><span class="badge <%= badgeClass %>"><%= statusText %></span></td>
                <td class="d-none d-md-table-cell"><%= m.location || '-' %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
