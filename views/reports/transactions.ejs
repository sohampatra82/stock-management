<%- include('../partials/header') %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h5 class="mb-0">Transaction Report</h5>
  <div>
    <a href="/reports/transactions?<%= Object.entries(filters).filter(([k,v]) => v).map(([k,v]) => k + '=' + encodeURIComponent(v)).join('&') %>&export=csv" class="btn btn-sm btn-outline-success">
      <i class="bi bi-download me-1"></i> Export CSV
    </a>
    <a href="/reports" class="btn btn-sm btn-outline-secondary">Back</a>
  </div>
</div>

<div class="panel mb-3">
  <div class="panel-body">
    <form method="GET" action="/reports/transactions" class="row g-2 align-items-end">
      <div class="col-6 col-md-2">
        <label class="form-label small">Type</label>
        <select name="type" class="form-select form-select-sm">
          <option value="">All</option>
          <option value="STOCK_IN" <%= filters.type === 'STOCK_IN' ? 'selected' : '' %>>Stock In</option>
          <option value="STOCK_OUT" <%= filters.type === 'STOCK_OUT' ? 'selected' : '' %>>Stock Out</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small">Period</label>
        <select name="period" class="form-select form-select-sm" id="periodSelect">
          <option value="">All Time</option>
          <option value="today" <%= filters.period === 'today' ? 'selected' : '' %>>Today</option>
          <option value="last7days" <%= filters.period === 'last7days' ? 'selected' : '' %>>Last 7 Days</option>
          <option value="thismonth" <%= filters.period === 'thismonth' ? 'selected' : '' %>>This Month</option>
          <option value="custom" <%= filters.period === 'custom' ? 'selected' : '' %>>Custom Range</option>
        </select>
      </div>
      <div class="col-6 col-md-2 custom-date" style="<%= filters.period === 'custom' ? '' : 'display:none' %>">
        <label class="form-label small">From</label>
        <input type="date" name="startDate" class="form-control form-control-sm" value="<%= filters.startDate %>">
      </div>
      <div class="col-6 col-md-2 custom-date" style="<%= filters.period === 'custom' ? '' : 'display:none' %>">
        <label class="form-label small">To</label>
        <input type="date" name="endDate" class="form-control form-control-sm" value="<%= filters.endDate %>">
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label small">Material</label>
        <select name="material" class="form-select form-select-sm">
          <option value="">All</option>
          <% materials.forEach(function(m) { %>
            <option value="<%= m._id %>" <%= filters.material === m._id.toString() ? 'selected' : '' %>><%= m.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <button type="submit" class="btn btn-sm btn-primary">Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Material</th>
            <th>Type</th>
            <th>Qty</th>
            <th>Previous</th>
            <th>New</th>
            <th class="d-none d-lg-table-cell">Party</th>
            <th class="d-none d-xl-table-cell">Purpose</th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No transactions found.</td></tr>
          <% } else { %>
            <% transactions.forEach(function(t) { %>
              <tr>
                <td class="text-nowrap small">
                  <%= new Date(t.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <div class="fw-semibold"><%= t.materialName %></div>
                  <code class="small"><%= t.materialCode %></code>
                </td>
                <td>
                  <% if (t.type === 'STOCK_IN') { %>
                    <span class="badge bg-success">IN</span>
                  <% } else { %>
                    <span class="badge bg-danger">OUT</span>
                  <% } %>
                </td>
                <td><strong><%= t.quantity %></strong></td>
                <td><%= t.previousQuantity %></td>
                <td><%= t.newQuantity %></td>
                <td class="d-none d-lg-table-cell small">
                  <%= t.type === 'STOCK_IN' ? (t.supplier || '-') : (t.issuedTo || '-') %>
                </td>
                <td class="d-none d-xl-table-cell small"><%= t.purpose || '-' %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.getElementById('periodSelect')?.addEventListener('change', function() {
    document.querySelectorAll('.custom-date').forEach(el => {
      el.style.display = this.value === 'custom' ? '' : 'none';
    });
  });
</script>

<%- include('../partials/footer') %>
