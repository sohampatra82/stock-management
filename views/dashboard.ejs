<%- include('partials/header') %>

<div class="page-header">
  <div>
    <div class="breadcrumb-nav"><a href="/dashboard">Home</a> / <span>Dashboard</span></div>
    <h1>Dashboard</h1>
    <p class="subtitle">Overview of your inventory and recent stock movements</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/stock/add" class="btn btn-success btn-sm"><i class="bi bi-box-arrow-in-down"></i> Stock In</a>
    <a href="/stock/reduce" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-up"></i> Stock Out</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <div class="stat-label">Total Materials</div>
        <div class="stat-value"><%= stats.totalMaterials %></div>
        <div class="stat-meta">Items in catalog</div>
      </div>
      <div class="stat-icon-wrap stat-icon-blue"><i class="bi bi-box"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <div class="stat-label">Total Stock Qty</div>
        <div class="stat-value"><%= stats.totalStock.toLocaleString() %></div>
        <div class="stat-meta">Units available</div>
      </div>
      <div class="stat-icon-wrap stat-icon-green"><i class="bi bi-layers"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <div class="stat-label">Low Stock</div>
        <div class="stat-value" style="color:var(--warning)"><%= stats.lowStockCount %></div>
        <div class="stat-meta">Need reorder</div>
      </div>
      <div class="stat-icon-wrap stat-icon-amber"><i class="bi bi-exclamation-triangle"></i></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="d-flex justify-content-between align-items-start">
      <div>
        <div class="stat-label">Out of Stock</div>
        <div class="stat-value" style="color:var(--danger)"><%= stats.outOfStockCount %></div>
        <div class="stat-meta">Zero quantity</div>
      </div>
      <div class="stat-icon-wrap stat-icon-red"><i class="bi bi-x-circle"></i></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="panel">
      <div class="panel-header">
        <h2><i class="bi bi-activity me-2 text-muted"></i>Recent Activity</h2>
        <a href="/stock/history" class="btn btn-ghost btn-sm">View all</a>
      </div>
      <div class="panel-body p-0">
        <% if (!recentTransactions || recentTransactions.length === 0) { %>
          <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>No transactions yet</h3>
            <p>Stock in or stock out movements will appear here.</p>
            <a href="/stock/add" class="btn btn-primary btn-sm">Add first stock</a>
          </div>
        <% } else { %>
          <% recentTransactions.forEach(function(t) { %>
            <div class="activity-item">
              <div class="activity-dot <%= t.type === 'STOCK_IN' ? 'in' : 'out' %>"></div>
              <div class="flex-grow-1">
                <div class="activity-title"><%= t.materialName %></div>
                <div class="activity-meta">
                  <% if (t.type === 'STOCK_IN') { %>
                    <span class="badge-status badge-in">IN</span> +<%= t.quantity %>
                  <% } else { %>
                    <span class="badge-status badge-out-tx">OUT</span> −<%= t.quantity %>
                  <% } %>
                  · Balance: <strong><%= t.newQuantity %></strong>
                  <% if (t.issuedTo) { %> · To: <%= t.issuedTo %><% } %>
                  <% if (t.supplier) { %> · From: <%= t.supplier %><% } %>
                </div>
              </div>
              <div class="text-muted small text-nowrap">
                <%= new Date(t.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) %>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="panel mb-3">
      <div class="panel-header">
        <h2 style="color:var(--warning)"><i class="bi bi-exclamation-triangle me-2"></i>Low Stock</h2>
        <a href="/reports/stock?status=low" class="btn btn-ghost btn-sm">Report</a>
      </div>
      <div class="panel-body p-0">
        <% if (!lowStockItems || lowStockItems.length === 0) { %>
          <div class="p-4 text-center text-muted small">All items above minimum level.</div>
        <% } else { %>
          <table class="data-table">
            <thead><tr><th>Material</th><th>Qty</th><th>Min</th></tr></thead>
            <tbody>
              <% lowStockItems.slice(0, 8).forEach(function(m) { %>
                <tr>
                  <td><a href="/materials/view/<%= m._id %>" class="item-name"><%= m.name %></a></td>
                  <td><span class="badge-status badge-low"><%= m.quantity %></span></td>
                  <td class="text-muted"><%= m.minimumStock %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="panel">
      <div class="panel-header">
        <h2 style="color:var(--danger)"><i class="bi bi-x-circle me-2"></i>Out of Stock</h2>
      </div>
      <div class="panel-body p-0">
        <% if (!outOfStockItems || outOfStockItems.length === 0) { %>
          <div class="p-4 text-center text-muted small">No out-of-stock items.</div>
        <% } else { %>
          <% outOfStockItems.slice(0, 6).forEach(function(m) { %>
            <div class="activity-item">
              <div class="flex-grow-1">
                <a href="/materials/view/<%= m._id %>" class="item-name"><%= m.name %></a>
                <div class="activity-meta"><code class="item-code"><%= m.code %></code></div>
              </div>
              <span class="badge-status badge-out">0</span>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
