<%- include('../partials/header') %>
<% 
  var badge = 'badge-available', statusText = 'Available';
  if (material.quantity <= 0) { badge = 'badge-out'; statusText = 'Out of Stock'; }
  else if (material.quantity <= material.minimumStock) { badge = 'badge-low'; statusText = 'Low Stock'; }
%>
<div class="page-header">
  <div>
    <div class="breadcrumb-nav"><a href="/dashboard">Home</a> / <a href="/materials">Materials</a> / <span><%= material.name %></span></div>
    <h1><%= material.name %></h1>
    <p class="subtitle"><span class="item-code"><%= material.code %></span> · <%= material.category %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/materials/edit/<%= material._id %>" class="btn btn-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
    <a href="/materials" class="btn btn-ghost btn-sm">Back</a>
  </div>
</div>
<div class="row g-3">
  <div class="col-md-8">
    <div class="panel"><div class="panel-body">
      <div class="row g-3">
        <div class="col-sm-6"><div class="text-muted small">Unit</div><div class="fw-600"><%= material.unit %></div></div>
        <div class="col-sm-6"><div class="text-muted small">Location</div><div class="fw-600"><%= material.location || '—' %></div></div>
        <div class="col-sm-6"><div class="text-muted small">Supplier</div><div class="fw-600"><%= material.supplierName || '—' %></div></div>
        <div class="col-sm-6"><div class="text-muted small">Supplier Contact</div><div class="fw-600"><%= material.supplierContact || '—' %></div></div>
        <div class="col-12"><div class="text-muted small">Description</div><div><%= material.description || '—' %></div></div>
        <div class="col-sm-6"><div class="text-muted small">Created</div><div><%= new Date(material.createdAt).toLocaleString('en-GB') %></div></div>
        <div class="col-sm-6"><div class="text-muted small">Updated</div><div><%= new Date(material.updatedAt).toLocaleString('en-GB') %></div></div>
      </div>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="panel mb-3">
      <div class="panel-body text-center py-4">
        <div class="text-muted small mb-1">Current Stock</div>
        <div style="font-size:2.5rem;font-weight:700;letter-spacing:-0.03em"><%= material.quantity %></div>
        <div class="text-muted"><%= material.unit %></div>
        <div class="mt-2"><span class="badge-status <%= badge %>"><%= statusText %></span></div>
      </div>
    </div>
    <div class="panel">
      <div class="panel-body">
        <div class="d-flex justify-content-between mb-3">
          <span class="text-muted">Minimum level</span>
          <strong><%= material.minimumStock %></strong>
        </div>
        <div class="d-grid gap-2">
          <a href="/stock/add" class="btn btn-success btn-sm"><i class="bi bi-box-arrow-in-down"></i> Stock In</a>
          <a href="/stock/reduce" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-up"></i> Stock Out</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
